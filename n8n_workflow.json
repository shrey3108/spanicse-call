    {
      "parameters": {
        "jsCode": "// Define working hours and slot duration\nconst START_HOUR = 9;   // 9:00 AM\nconst END_HOUR = 18;    // 6:00 PM\nconst SLOT_DURATION = 30; // 30 minutes\n\nconst items = $input.all();\nconst requestDate = $('Extract Tool Call').first().json.args.date;\nconst toolCallId = $('Extract Tool Call').first().json.toolCallId;\nconst industry = $('Extract Tool Call').first().json.args.industry || 'General';\n\n// Get booked time ranges\nconst bookedSlots = [];\nfor (const item of items) {\n  if (item.json.start && item.json.start.dateTime) {\n    const start = new Date(item.json.start.dateTime);\n    const end = new Date(item.json.end.dateTime);\n    bookedSlots.push({\n      startHour: start.getHours(),\n      startMin: start.getMinutes(),\n      endHour: end.getHours(),\n      endMin: end.getMinutes()\n    });\n  }\n}\n\n// Generate available slots\nconst availableSlots = [];\nfor (let hour = START_HOUR; hour < END_HOUR; hour++) {\n  for (let min = 0; min < 60; min += SLOT_DURATION) {\n    const slotStartTotal = hour * 60 + min;\n    const slotEndTotal = slotStartTotal + SLOT_DURATION;\n    \n    let isAvailable = true;\n    for (const booked of bookedSlots) {\n      const bookedStart = booked.startHour * 60 + booked.startMin;\n      const bookedEnd = booked.endHour * 60 + booked.endMin;\n      if (slotStartTotal < bookedEnd && slotEndTotal > bookedStart) {\n        isAvailable = false;\n        break;\n      }\n    }\n    \n    if (isAvailable) {\n      const timeStr = `${hour.toString().padStart(2, '0')}:${min.toString().padStart(2, '0')}`;\n      const displayHour = hour > 12 ? hour - 12 : hour;\n      const ampm = hour >= 12 ? 'PM' : 'AM';\n      const displayTime = `${displayHour}:${min.toString().padStart(2, '0')} ${ampm}`;\n      availableSlots.push({ time24: timeStr, display: displayTime });\n    }\n  }\n}\n\nlet resultText;\nif (availableSlots.length === 0) {\n  resultText = `No available slots on ${requestDate} for ${industry}. Would you like to check another date?`;\n} else {\n  const slotList = availableSlots.map(s => s.display).slice(0, 4).join(', ');\n  resultText = `Available slots on ${requestDate}: ${slotList}. Which time works best for you?`;\n}\n\nreturn [{\n  json: {\n    results: [\n      {\n        toolCallId: toolCallId,\n        result: resultText\n      }\n    ]\n  }\n}];"
      },
