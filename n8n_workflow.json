      "parameters": {
        "jsCode": "// Extract tool call data from Vapi payload\nconst body = $input.first().json.body || $input.first().json;\n\nlet toolCall;\nlet functionName;\nlet args;\nlet toolCallId;\n\n// Handle Vapi tool call format\nif (body.message && body.message.toolCallList) {\n  toolCall = body.message.toolCallList[0];\n  functionName = toolCall.function.name;\n  args = toolCall.function.arguments;\n  toolCallId = toolCall.id;\n} else if (body.message && body.message.toolCalls) {\n  toolCall = body.message.toolCalls[0];\n  functionName = toolCall.function.name;\n  args = typeof toolCall.function.arguments === 'string' \n    ? JSON.parse(toolCall.function.arguments) \n    : toolCall.function.arguments;\n  toolCallId = toolCall.id;\n} else {\n  // Direct function call format\n  functionName = body.functionName || body.name || 'unknown';\n  args = body.arguments || body.parameters || body;\n  toolCallId = body.toolCallId || body.id || 'unknown';\n}\n\nreturn [{\n  json: {\n    functionName,\n    args,\n    toolCallId,\n    rawBody: body\n  }\n}];"
      },
