      "parameters": {
        "jsCode": "// Extract tool call data from Vapi payload for Multi-Industry\nconst body = $input.first().json.body || $input.first().json;\n\nlet toolCall;\nlet functionName;\nlet args;\nlet toolCallId;\n\n// Handle Vapi tool call format\nif (body.message && body.message.toolCallList) {\n  toolCall = body.message.toolCallList[0];\n  functionName = toolCall.function.name;\n  args = typeof toolCall.function.arguments === 'string' ? JSON.parse(toolCall.function.arguments) : toolCall.function.arguments;\n  toolCallId = toolCall.id;\n} else if (body.message && body.message.toolCalls) {\n  toolCall = body.message.toolCalls[0];\n  functionName = toolCall.function.name;\n  args = typeof toolCall.function.arguments === 'string' \n    ? JSON.parse(toolCall.function.arguments) \n    : toolCall.function.arguments;\n  toolCallId = toolCall.id;\n} else {\n  functionName = body.functionName || body.name || 'unknown';\n  args = body.arguments || body.parameters || body;\n  toolCallId = body.toolCallId || body.id || 'unknown';\n}\n\n// Normalize multi-industry fields seamlessly\nargs.customerName = args.customerName || args.patientName || 'Valued Client';\nargs.serviceName = args.serviceName || args.treatment || 'Consultation / Visit';\nargs.phoneNumber = args.phoneNumber || 'N/A';\n\n// Smart AI Auto-Detection of Industry Category\nlet ind = args.industry || (body.message && body.message.call && body.message.call.variableValues && body.message.call.variableValues.industry);\n\nif (!ind || ind === 'General') {\n  const text = ((args.serviceName || '') + ' ' + (args.treatment || '') + ' ' + (args.notes || '')).toLowerCase();\n  \n  if (/plumb|leak|pipe|ac|carpenter|furniture|repair|electric|hvac|maintenance|repair/i.test(text)) {\n    ind = 'Home Services';\n  } else if (/table|guest|restaurant|patio|dining|bistro|food|party|dinner|lunch|reservation/i.test(text)) {\n    ind = 'Restaurant & Lounge';\n  } else if (/house|flat|apartment|villa|property|real estate|site visit|realty|valuation|home/i.test(text)) {\n    ind = 'Real Estate';\n  } else if (/car|suv|test drive|oil change|brake|auto|vehicle|dealership|motors/i.test(text)) {\n    ind = 'Car Dealership';\n  } else if (/doctor|medical|clinic|teeth|dental|primary care|tooth|swollen|checkup|health/i.test(text)) {\n    ind = 'Medical & Dental';\n  } else {\n    ind = 'General Business';\n  }\n}\n\nargs.industry = ind;\n\nreturn [{\n  json: {\n    functionName,\n    args,\n    toolCallId,\n    rawBody: body\n  }\n}];"
      },
