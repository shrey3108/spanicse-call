      "parameters": {
        "jsCode": "const toolCallId = $('Extract Tool Call').first().json.toolCallId;\nconst args = $('Extract Tool Call').first().json.args;\n\nconst hour = parseInt(args.time.split(':')[0]);\nconst min = args.time.split(':')[1];\nconst displayHour = hour > 12 ? hour - 12 : hour;\nconst ampm = hour >= 12 ? 'PM' : 'AM';\nconst displayTime = `${displayHour}:${min} ${ampm}`;\n\nreturn [{\n  json: {\n    results: [\n      {\n        toolCallId: toolCallId,\n        result: `Appointment confirmed for ${args.patientName} on ${args.date} at ${displayTime}. A confirmation will be sent to ${args.phoneNumber}.`\n      }\n    ]\n  }\n}];"
