    {
      "parameters": {
        "jsCode": "const toolCallId = $('Extract Tool Call').first().json.toolCallId;\nconst args = $('Extract Tool Call').first().json.args;\n\nlet resultText;\nif (args.leadScore === 'hot') {\n  resultText = `Saved ${args.customerName}'s details. Marked as HIGH-PRIORITY lead for immediate follow-up.`;\n} else if (args.leadScore === 'warm') {\n  resultText = `Saved ${args.customerName}'s details for ${args.serviceName}. Our team will reach out.`;\n} else {\n  resultText = `Saved ${args.customerName}'s contact information.`;\n}\n\nreturn [{\n  json: {\n    results: [\n      {\n        toolCallId: toolCallId,\n        result: resultText\n      }\n    ]\n  }\n}];"
      },
