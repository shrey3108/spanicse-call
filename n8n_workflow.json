    {
      "parameters": {
        "jsCode": "const toolCallId = $('Extract Tool Call').first().json.toolCallId;\nconst args = $('Extract Tool Call').first().json.args;\n\nlet resultText;\nif (args.leadScore === 'hot') {\n  resultText = `I've saved ${args.patientName}'s details. They are marked as a high-priority lead. Our team will follow up shortly.`;\n} else if (args.leadScore === 'warm') {\n  resultText = `I've noted ${args.patientName}'s details. Our team will reach out to help schedule an appointment.`;\n} else {\n  resultText = `I've saved ${args.patientName}'s information for future reference.`;\n}\n\nreturn [{\n  json: {\n    results: [\n      {\n        toolCallId: toolCallId,\n        result: resultText\n      }\n    ]\n  }\n}];"
      },
