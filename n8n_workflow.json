      "parameters": {
        "jsCode": "const toolCallId = $('Extract Tool Call').first().json.toolCallId;\nconst args = $('Extract Tool Call').first().json.args;\n\nconst timeParts = (args.time || '10:00').split(':');\nconst hour = parseInt(timeParts[0]);\nconst min = timeParts[1] || '00';\nconst displayHour = hour > 12 ? hour - 12 : hour;\nconst ampm = hour >= 12 ? 'PM' : 'AM';\nconst displayTime = `${displayHour}:${min} ${ampm}`;\n\nreturn [{\n  json: {\n    results: [\n      {\n        toolCallId: toolCallId,\n        result: `Booking confirmed for ${args.customerName} (${args.serviceName}) on ${args.date} at ${displayTime}.`\n      }\n    ]\n  }\n}];"
